    <mxCell id="host" value="&lt;b&gt;Creative application / host-owned lifecycle&lt;/b&gt;&lt;br&gt;Maya / Houdini / Nuke / Blender / Unreal / Unity&lt;br&gt;Each target needs its own native and interaction acceptance" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d9eade;strokeColor=#14674f;fontColor=#172b2a;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="730" height="110" as="geometry"/></mxCell>
