<mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1080" background="#f6f7f5">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="Proposed shared runtime: one host capability, two entry points" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#172b2a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="50" as="geometry"/></mxCell>
    <mxCell id="people" value="&lt;b&gt;People / Web interface&lt;/b&gt;&lt;br&gt;Modern frontend development&lt;br&gt;AI-assisted UI implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfdfb;strokeColor=#ccd5d0;fontColor=#172b2a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="340" height="100" as="geometry"/></mxCell>
    <mxCell id="agents" value="&lt;b&gt;Agent / explicit tools and Skills&lt;/b&gt;&lt;br&gt;Parameters, results, errors, thread requirements&lt;br&gt;Reuse the same host business capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfdfb;strokeColor=#ccd5d0;fontColor=#172b2a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="100" width="360" height="100" as="geometry"/></mxCell>
    <mxCell id="ui" value="&lt;b&gt;AuroraView&lt;/b&gt;&lt;br&gt;WebView / rendering / HTML and assets&lt;br&gt;Frontend bridge and events&lt;br&gt;Native region display and docking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eade;strokeColor=#14674f;fontColor=#172b2a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="thin" value="&lt;b&gt;Thin integration layer / proposed&lt;/b&gt;&lt;br&gt;Explicit calls and event mapping&lt;br&gt;Attach, connect, and subscribe&lt;br&gt;Runtime ownership and release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfdfb;strokeColor=#526460;dashed=1;fontColor=#172b2a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="260" width="340" height="140" as="geometry"/></mxCell>
    <mxCell id="mcp" value="&lt;b&gt;DCC-MCP Core / existing infrastructure&lt;/b&gt;&lt;br&gt;Server / MCP / tool and Skill registry&lt;br&gt;Host execution bridge and diagnostics&lt;br&gt;Service lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eade;strokeColor=#14674f;fontColor=#172b2a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="260" width="360" height="140" as="geometry"/></mxCell>
    <mxCell id="ownership" value="&lt;b&gt;Proposed resource ownership&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prefer attaching to an existing host service&lt;br&gt;Create missing resources when needed&lt;br&gt;&lt;br&gt;Panel releases its connections and tasks&lt;br&gt;Borrowed services remain host-owned&lt;br&gt;Creators fully close owned resources&lt;br&gt;Shutdown must be repeatable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf0ed;strokeColor=#526460;dashed=1;fontColor=#172b2a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="340" height="300" as="geometry"/></mxCell>
    <mxCell id="bridge" value="&lt;b&gt;Host execution bridge and native adapter&lt;/b&gt;&lt;br&gt;Main-thread dispatch / scene API / window integration / event loop&lt;br&gt;Share declared business capability between page and Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfdfb;strokeColor=#ccd5d0;fontColor=#172b2a;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="780" height="110" as="geometry"/></mxCell>
    <mxCell id="host" value="&lt;b&gt;One native host instance and lifecycle&lt;/b&gt;&lt;br&gt;Maya / Blender / Unreal / Unity / other adapters&lt;br&gt;Scene state and operation results must be read back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9eade;strokeColor=#14674f;fontColor=#172b2a;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="680" width="780" height="110" as="geometry"/></mxCell>
    <mxCell id="status" value="&lt;b&gt;PROPOSED INTEGRATION, NOT A DELIVERED REFACTOR&lt;/b&gt;&lt;br&gt;Compatibility, event/error mapping, ownership, reconnect, native docking, and real-host behavior still need implementation and acceptance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf0ed;strokeColor=#526460;dashed=1;fontColor=#172b2a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1170" height="80" as="geometry"/></mxCell>
    <mxCell id="note" value="AuroraView retains web assets, rendering, optional browser/extensions, and build-time packing. DCC-MCP owns host execution and service infrastructure. This diagram defines responsibilities, not new public API names or a measured reuse percentage." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#526460;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1170" height="60" as="geometry"/></mxCell>
    <mxCell id="people-ui" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="people" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="ui-thin" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ui" target="thin"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="thin-mcp" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="thin" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="agents-mcp" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="agents" target="mcp"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="mcp-bridge" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="mcp" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="ui-bridge" value="native presentation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="thin" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="bridge-host" value="scene capabilities" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#14674f;endArrow=classic;startArrow=classic;" edge="1" parent="1" source="bridge" target="host"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
